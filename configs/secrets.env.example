# Copy to configs/secrets.env (never commit that file; .gitignore excludes it) and fill in.
# scripts/mac_phase5.sh setup and telegram fill in most of it for you.
# Environment variables with the same names win over this file.

# The local database's password, made up by `python scripts/db.py init`.
PPE_DB_PASSWORD=
# Or a complete database address instead (e.g. a server's PostgreSQL, or sqlite:///data/ppe.sqlite)
# DATABASE_URL=

# Telegram: create a bot with @BotFather, then run: bash scripts/mac_phase5.sh telegram
TELEGRAM_BOT_TOKEN=
# One or more chat ids, separated by commas (a person, or a group the bot was added to).
TELEGRAM_CHAT_ID=

# Email (e.g. Gmail: smtp.gmail.com, port 587, and an app password, not your normal password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
# One or more addresses, separated by commas
EMAIL_TO=

# Needed only if the dashboard listens beyond this Mac (dashboard.host other than 127.0.0.1).
DASHBOARD_USER=safety
DASHBOARD_PASSWORD=
